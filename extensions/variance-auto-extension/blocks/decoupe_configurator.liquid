<div
  class="variance-decoupe-configurator"
  id="variance-decoupe-configurator"
  data-api-base="/apps/customizer"
  style="display: none;"
>
  <div class="decoupe-container">
    <!-- Left Column: Image Preview -->
    <div class="decoupe-preview-pane">
      <div id="decoupe-image-loading" class="preview-spinner hidden">⏳</div>
      <div id="decoupe-image-wrapper" class="preview-image-wrapper">
        <img id="decoupe-preview-img" src="" alt="Product Preview" class="hidden">
        <div id="decoupe-preview-placeholder" class="preview-placeholder">
          <span>📏</span>
          <p>Select an option to view image</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Controls -->
    <div class="decoupe-control-pane">
      <h2 class="decoupe-title">{{ product.title }}</h2>

      <!-- Option Selector -->
      <div class="decoupe-field-group">
        <label for="decoupe-select" class="field-label">Option / Product Type</label>
        <div class="decoupe-select-wrapper">
          <select id="decoupe-select">
            <option value="">Choose an option...</option>
          </select>
          <span class="select-chevron">▼</span>
        </div>
      </div>

      <!-- Loading State -->
      <div id="decoupe-detail-loading" class="detail-loader hidden">
        <span>⏳ Loading item details...</span>
      </div>

      <!-- Details & Calculation Section -->
      <div id="decoupe-detail-card" class="decoupe-detail-card hidden">
        <!-- Info Rows -->
        <div class="decoupe-info-grid">
          <div class="info-row" id="row-ref">
            <span class="info-label">Ref:</span>
            <span class="info-value" id="val-ref">N/A</span>
          </div>

          <div class="info-row" id="row-laize-single">
            <span class="info-label">Breedte / laize:</span>
            <span class="info-value" id="val-laize-single">N/A</span>
          </div>

          <div class="info-row" id="row-length-default">
            <span class="info-label">Lengte:</span>
            <span class="info-value" id="val-length-default">N/A</span>
          </div>

          <div class="info-row" id="row-price">
            <span class="info-label">Price:</span>
            <span class="info-value" id="val-price">N/A</span>
          </div>

          <div class="info-row" id="row-commercial-ref">
            <span class="info-label">Commercial Ref:</span>
            <span class="info-value" id="val-commercial-ref">N/A</span>
          </div>
        </div>

        <!-- Dynamic Laize Input (Only shown for multi-laize products) -->
        <div class="decoupe-field-group hidden" id="decoupe-laize-group">
          <label for="decoupe-laize-select" class="field-label">Select Width (Laize)</label>
          <div class="decoupe-select-wrapper">
            <select id="decoupe-laize-select"></select>
            <span class="select-chevron">▼</span>
          </div>
        </div>

        <!-- Length Input (Aantal / Quantity) -->
        <div class="decoupe-field-group" id="decoupe-length-group">
          <div class="length-label-row">
            <label for="decoupe-length-input" class="field-label">Car Film aantal (lengte, cm)</label>
          </div>
          <div class="length-input-wrapper">
            <input type="number" id="decoupe-length-input" value="100" min="1" step="1">
            <span class="unit-badge">cm</span>
          </div>
        </div>

        <!-- Pricing Card -->
        <div class="decoupe-pricing-card">
          <div class="price-line">
            <span class="price-label">Price per sq.m</span>
            <span class="price-value" id="decoupe-sqm-price">0.00 €</span>
          </div>
          <div class="total-price-line">
            <span class="total-label">Total Price</span>
            <div class="price-box">
              <span class="total-price-value" id="decoupe-total-price">0.00 €</span>
            </div>
          </div>
        </div>

        <!-- Add to Cart Button -->
        <button id="decoupe-add-to-cart-btn" class="decoupe-add-to-cart-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.7 15.3C4.3 15.7 4.6 16.5 5.1 16.5H17M17 13V16.5M17 16.5C17 17.9 15.9 19 14.5 19C13.1 19 12 17.9 12 16.5C12 15.1 13.1 14 14.5 14C15.9 14 17 15.1 17 16.5ZM9 16.5C9 17.9 7.9 19 6.5 19C5.1 19 4 17.9 4 16.5C4 15.1 5.1 14 6.5 14C7.9 14 9 15.1 9 16.5Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Add to Cart
        </button>
      </div>
    </div>
  </div>
  <div id="decoupe-description" class="decoupe-description"></div>
</div>

<script>
  window.VarianceDecoupeConfig = {
    productId: {{ product.id | json }},
    productPrice: {{ product.price | divided_by: 100.00 | json }},
    storeLanguage: "{{ localization.language.iso_code }}"
  };
  window.Shopify = window.Shopify || {};
  window.Shopify.shop = "{{ shop.permanent_domain }}";
</script>

{% schema %}
{
  "name": "Decoupe Configurator",
  "target": "section",
  "stylesheet": "decoupe-style.css",
  "javascript": "decoupe-script.js",
  "settings": []
}
{% endschema %}
